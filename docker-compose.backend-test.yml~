services:

  backend:
    build: ./backend
    ports:
      - "8000:8000"

    env_file:
      - ./backend/.env

    depends_on:
      - postgres
      - redis

    volumes:
      - ./backend:/app

  postgres:
    image: postgres:17

    env_file:
      - ./backend/.env

  redis:
    image: redis:8

  celery-worker:
    build: ./backend
    command: celery -A api worker -l info

    env_file:
      - ./backend/.env

    depends_on:
      - redis

  celery-beat:
    build: ./backend
    command: celery -A api beat -l info

    env_file:
      - ./backend/.env
