DEBUG=True

SECRET_KEY=some-dev-secret

POSTGRES_DB=hilkebank
POSTGRES_USER=hilkebank
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Production only: your public domain(s) and, if behind a reverse proxy
# that doesn't forward the original Host header unchanged, its HTTPS
# origin(s) -- needed for Django's CSRF check to accept admin logins over
# HTTPS (see README.md -> Before deploying anywhere but a trusted
# local/staging host).
#ALLOWED_HOSTS=bank.example.com
#CSRF_TRUSTED_ORIGINS=https://bank.example.com

# Optional: pre-fill `create_parent` (./scripts/create_initial_parent.sh /
# make create-parent), so it doesn't need to prompt. Uncomment and set a
# real password before use -- left unset here on purpose so a plaintext
# admin password is never committed.
#INITIAL_PARENT_USERNAME=
#INITIAL_PARENT_PASSWORD=
#INITIAL_PARENT_EMAIL=
#INITIAL_PARENT_FIRST_NAME=
#INITIAL_PARENT_LAST_NAME=
#INITIAL_PARENT_SUPERUSER=true

# Optional: enables "Sign in with Google" (front-page account creation +
# login for parents). Create an OAuth 2.0 Client ID of type "Web
# application" in Google Cloud Console (APIs & Services -> Credentials),
# add every origin the frontend is served from (e.g.
# http://localhost:5173 for `bun run dev`, https://bank.example.com in
# production) under "Authorized JavaScript origins", and paste the
# resulting client id below. Left unset, the frontend hides the Google
# button instead of showing a broken one.
GOOGLE_OAUTH_CLIENT_ID=320077592244-fl15v4bicbdld65rq4bdfk6g03deh9gt.apps.googleusercontent.com
